# Copy to .env and adjust (never commit .env).
# After changing values, run `npm start` or `node scripts/generate-environment.mjs`
# so `environment.defaults.ts` is regenerated for `ng serve`.

# --- Local FastAPI (default dev targets) ---
AUDITIQ_API_BASE_URL=http://localhost:8000/api
AUDITIQ_WS_BASE_URL=ws://localhost:8000

# --- Deployed SPA (e.g. Netlify same-origin proxy) ---
# AUDITIQ_API_BASE_URL=/api
# AUDITIQ_WS_BASE_URL=
# Netlify: set the same variable names in Site settings → Environment variables.

# Aliases (optional) — some teams prefer NG_APP_*:
# NG_APP_API_BASE_URL=
# NG_APP_WS_BASE_URL=
