# Copy to .env and adjust (never commit .env).
# After changing values, run `npm start` or `node scripts/generate-environment.mjs`
# so `environment.defaults.ts` is regenerated for `ng serve`.

# --- Local FastAPI (default dev targets) ---
AUDITIQ_API_BASE_URL=http://localhost:8000/api
AUDITIQ_WS_BASE_URL=ws://localhost:8000

# --- Production (recommandé : API en Docker sur Render, pas Netlify Functions) ---
# SPA Netlify: https://auditiq-front.netlify.app/
# Après déploiement Render (render.yaml), remplacer par votre URL réelle :
# AUDITIQ_API_BASE_URL_PRODUCTION=https://<votre-service>.onrender.com/api
# AUDITIQ_WS_BASE_URL_PRODUCTION=wss://<votre-service>.onrender.com

# Aliases (optional) — some teams prefer NG_APP_*:
# NG_APP_API_BASE_URL=
# NG_APP_WS_BASE_URL=
