# Copy to .env and adjust (never commit .env).
# After changing values, run `npm start` or `node scripts/generate-environment.mjs`
# so `environment.defaults.ts` is regenerated for `ng serve`.

# --- Local FastAPI (default dev targets) ---
AUDITIQ_API_BASE_URL=http://localhost:8000/api
AUDITIQ_WS_BASE_URL=ws://localhost:8000

# --- Production URLs (baked in scripts/generate-environment.mjs by default) ---
# SPA: https://auditiq-front.netlify.app/
# API: https://grand-sawine-e82b5d.netlify.app  (paths under /api)
# Optional overrides for `ng build` / Netlify CI:
# AUDITIQ_API_BASE_URL_PRODUCTION=https://grand-sawine-e82b5d.netlify.app/api
# AUDITIQ_WS_BASE_URL_PRODUCTION=wss://grand-sawine-e82b5d.netlify.app

# Aliases (optional) — some teams prefer NG_APP_*:
# NG_APP_API_BASE_URL=
# NG_APP_WS_BASE_URL=
