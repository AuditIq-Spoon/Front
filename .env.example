# Copy to .env and adjust (never commit .env).
# After changing values, run `npm start` or `node scripts/generate-environment.mjs`
# so `environment.defaults.ts` is regenerated for `ng serve`.

# --- Local FastAPI (default dev targets) ---
AUDITIQ_API_BASE_URL=http://localhost:8000/api
AUDITIQ_WS_BASE_URL=ws://localhost:8000

# --- Production (SPA Netlify → API FastAPI sur Vercel) ---
# Backend: https://auditiq-back.vercel.app — décommenter pour builds Netlify / prod.
# AUDITIQ_API_BASE_URL_PRODUCTION=https://auditiq-back.vercel.app/api
# AUDITIQ_WS_BASE_URL_PRODUCTION=wss://auditiq-back.vercel.app

# Aliases (optional) — some teams prefer NG_APP_*:
# NG_APP_API_BASE_URL=
# NG_APP_WS_BASE_URL=
